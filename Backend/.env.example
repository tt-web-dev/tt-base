# TT-Kickbase backend env. Copy to .env for local dev (Backend/.env is gitignored).
# On Render set these as environment variables; on GitHub Actions as repo secrets.

# Supabase project (Project Settings -> API). Service role key stays server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# myTT premium session cookie (Render owns refresh; the nightly job uses a copy).
MYTT_COOKIE=

# Deployed frontend origin(s), comma-separated. Locks down CORS in production.
CORS_ORIGIN=https://your-frontend.onrender.com

# Port is provided by Render automatically; keep 3000 for local dev.
PORT=3000
